# Deployment defaults for the autonomous runner and the helper scripts. A
# variable set in the environment wins over its line here. config/CLAUDE.md
# gives the format; docs/AUTONOMOUS.md says what each key does.

# Where runs live, where they are published, and who hears about them.
RESEARCHER_STORAGE_ROOT=/media/titus/big
RESEARCHER_GITHUB_OWNER=tbuckworth
RESEARCHER_TASKS_REPO=tbuckworth/tasks
RESEARCHER_EMAIL_TO=titusbuckworth@gmail.com
RESEARCHER_DEFAULT_KB_DIR=~/pyg/research-wiki
RESEARCHER_HOST_ALIASES=titus-MS-7A59=desktop
# The local code a run may search (read-only), and the checkout of this
# repository that runs autonomous runs (/researcher-continue starts them there).
RESEARCHER_CODE_SEARCH_DIR=~/pyg
RESEARCHER_RUNNER_DIR=~/pyg/researcher

# The agent CLIs and the models they run.
RESEARCHER_BACKEND=claude
RESEARCHER_CLAUDE_BIN=claude
RESEARCHER_CODEX_BIN=codex
RESEARCHER_CLAUDE_MODEL=fable
RESEARCHER_EMAIL_CLAUDE_MODEL=sonnet
RESEARCHER_CODEX_MODEL=gpt-6-astra
RESEARCHER_CODEX_REASONING=xhigh
RESEARCHER_CODEX_FAST_MODEL=gpt-6.1-sol
RESEARCHER_CODEX_FAST_REASONING=medium
RESEARCHER_CODEX_SANDBOX=danger-full-access
RESEARCHER_CODEX_APPROVAL_POLICY=never
RESEARCHER_CODEX_IGNORE_USER_CONFIG=true
RESEARCHER_CODEX_MAX_SUBAGENTS=4

# The compute profile: a preset in config/compute-profiles/, or the profile text.
RESEARCHER_COMPUTE_PROFILE=local

# The limits every run keeps to; the runtime header gives them to each step.
RESEARCHER_MAX_EXPERIMENTS=5
RESEARCHER_EXPERIMENT_MINUTES=30
RESEARCHER_MAX_FILE_MB=50
RESEARCHER_MAX_AUDIT_ROUNDS=3
